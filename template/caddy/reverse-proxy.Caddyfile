# phppgadmin
#pga.twojadomena.pl {
#    header -X-Powered-By
#    root * /opt/caddy-dashboard/phppgadmin
#    php_fastcgi unix//opt/caddy-dashboard/run/phppgadmin.sock
#    file_server
