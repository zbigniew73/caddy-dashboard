# === TRYB DZIALANIA - trzy opcje, EXPOSURE i HOST musza sie zgadzac ===
#
# local (domyslny) - tylko ta maszyna, HOST musi zostac 127.0.0.1
# lan             - inne urzadzenia w Twojej sieci lokalnej, bez Caddy
# world           - dostep z internetu przez Twoja domene, przez Caddy
#
EXPOSURE=lan
#
# ZMIEN ponizszy adres na SWOJ realny adres LAN serwera (sprawdzisz:
# `ip addr` / `hostname -I`).
HOST=192.168.1.100
PORT=4300
#
# --- Gdy zechcesz przejsc na EXPOSURE=world (dostep z internetu) ---
# 1. Zmien powyzej: EXPOSURE=world, HOST=127.0.0.1 (node ma nasluchiwac
#    WYLACZNIE lokalnie na serwerze - to Caddy odbiera ruch z internetu).
# 2. Dodaj w konfiguracji Caddy osobna subdomene, np.:
#
#      panel.twojadomena.pl {
#          reverse_proxy 127.0.0.1:4300
#      }

# Logowanie przez konta systemowe (PAM), whitelist loginow ktore moga sie
# zalogowac (login+haslo takie jak przy SSH). Kilka loginow oddzielonych
# przecinkiem, np. AUTH_USERS=zibi,ania
#
# WYMAGANIA SYSTEMOWE: proces node musi byc rootem ALBO czlonkiem grupy
# `shadow`, inaczej PAM pozwoli sprawdzac tylko haslo wlasnego uzytkownika
# procesu, nie kont z tej listy.
AUTH_USERS=zmien-na-swoj-login,opcjonalnie-drugi-login

# Sekret do podpisywania sesji logowania (zawsze wymagany).
# Wygeneruj: openssl rand -hex 32
SESSION_SECRET=zmien-to-na-losowy-64-znakowy-hex

# Opcjonalne dodatkowe zawezenie CORS - w tej architekturze (frontend i API
# serwowane z tego samego originu) praktycznie niepotrzebne.
ALLOWED_ORIGIN=

# Opcjonalnie: nazwa uslugi PAM uzywanej do logowania (domyslnie "login").
# PAM_SERVICE=login
